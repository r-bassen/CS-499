<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{title}}</title>
    <link rel='stylesheet' href='/css/style.css' />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div id="background">
        <div id="page">
            {{> header}}
            {{{body}}}
        </div>
        {{> footer}}
        </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {

            const token = localStorage.getItem('token');

            const reservationsLink = document.getElementById('reservations-link');
            const loginLink = document.getElementById('login-link');
            const adminLink = document.getElementById('admin-link');

            if (token) {
                if (reservationsLink) reservationsLink.style.display = 'inline';
                if (loginLink) loginLink.style.display = 'none';
            } else {
                if (reservationsLink) reservationsLink.style.display = 'none';
                if (adminLink) adminLink.style.display = 'inline';
            }
            //reserveButtons.forEach(button => {
            //    button.addEventListener('click', () => {
            //        const tripCode = button.getAttribute('data-trip-code');
            //        window.location.href = `/checkout/${tripCode}`;
            //    });
            //});
        });
    </script>
</body>
</html>
