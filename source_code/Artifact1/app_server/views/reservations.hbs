<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Travel - Travlr Getaways</title>
    <link rel="stylesheet" href="/css/style.css" type="text/css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div id="background">
        <div id="page">
            {{> header}}
            <div id="contents">
                <div class="box">
                    <div>
                        <div class="body">
                            <h2>My Reservations</h2>

                            {{#if reservations.length}}
                            {{#each reservations}}
                            <div class="reservation-item" style="border: 1px solid #ccc; padding: 15px; margin-bottom: 15px;">
                                <h3>{{this.tripName}}</h3>
                                <p><strong>Trip Code:</strong> {{this.tripCode}}</p>
                                <p><strong>Number of Guests:</strong> {{this.numGuests}}</p>
                                <p><strong>Reservation Date:</strong> {{this.createdAt}}</p>
                                <p><strong>Reservation ID:</strong> {{this._id}}</p>
                            </div>
                            {{/each}}
                            {{else}}
                            <p>You don't have any reservations yet.</p>
                            <a href="/travel?token={{token}}" class="btn btn-primary">Browse Trips</a>
                            {{/if}}

                            <br>
                            <a href="/travel?token={{token}}" class="btn btn-primary">Back to Trips</a>
                        </div>
                    </div>
                    {{> footer}}
                </div>
            </div>
        </div>
    </div>
</body>
</html>